# Public canonical origin. Set to the exact preview origin when testing submissions.
SITE_URL=https://www.cryol.in
# Server-only values. Never prefix these with NEXT_PUBLIC_.
GMAIL_USER=cryoltechnologies@gmail.com
GMAIL_APP_PASSWORD=
FIREBASE_PROJECT_ID=
# Local/non-Google hosting: path to a service account JSON stored outside the repo.
# Firebase App Hosting: use the runtime service account / Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=
# Generate a random secret of at least 32 bytes.
ENQUIRY_RATE_LIMIT_SECRET=
# Separate random server-only secret for CSRF token signing (at least 32 characters).
ENQUIRY_CSRF_SECRET=
# Public widget key (provided at build time) and server-only verification secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GitHub-backed Decap CMS (no content database).
# Exact origin of the CMS, including protocol. Use a separate OAuth app for localhost.
CMS_SITE_URL=https://www.cryol.in
CMS_GITHUB_REPO=iamraghavan/Cryol
CMS_GITHUB_BRANCH=main
# Choose public only if the repository is public; otherwise use private.
CMS_GITHUB_REPO_VISIBILITY=private
# Comma-separated GitHub usernames allowed to sign in. Each also needs repo write access.
CMS_GITHUB_ALLOWED_USERS=iamraghavan
CMS_GITHUB_CLIENT_ID=
CMS_GITHUB_CLIENT_SECRET=
# Generate a random server-only secret, at least 32 characters.
CMS_SESSION_SECRET=
